.env
__pycache__/
*.pyc
.DS_Store
.claude.json
.claude/

# ข้อมูลส่วนตัว/ฐานข้อมูล — ห้าม track (AUDIT.md H1)
vaultis.db
portfolio/data/transactions.csv
# พอร์ตทดลอง DAR-DCA — สมุดของมันเองเป็นข้อมูลส่วนตัวเหมือนสมุดหลัก (.tmp = ไฟล์ข้างเคียงของการบันทึกแบบ atomic)
portfolio/data/dar_transactions.csv
portfolio/data/dar_transactions.csv.tmp
portfolio/data/select_transactions.csv
portfolio/data/select_transactions.csv.tmp
portfolio/data/stock_transactions.csv
portfolio/data/stock_transactions.csv.tmp
portfolio/data/predict_log.csv
portfolio/data/predict_log.csv.tmp
portfolio/data/trade_log.csv
portfolio/data/trade_log.csv.tmp
.dar_scheduler_state.json
.dar_scheduler_state.json.tmp
.select_scheduler_state.json
.select_scheduler_state.json.tmp

# ข้อมูลรันไทม์ของ Docker (SQLite) — ห้าม track (AUDIT.md H1)
# ignore เฉพาะ "ของข้างใน" ไม่ใช่ตัวโฟลเดอร์ — ต้องเหลือ .gitkeep ไว้ให้ fresh clone
# ไม่งั้น docker สร้างโฟลเดอร์นี้เป็นของ root แล้ว container (uid ของ host) เขียน
# vaultis.db ไม่ได้ → backend crash-loop "unable to open database file"
.docker-data/*
!.docker-data/.gitkeep
# alert ส่วนตัว — ห้าม track (repo เป็น public)
# .bak/.lock/.tmp คือไฟล์ข้างเคียงของการบันทึกแบบ atomic ใน alerts/price_alert.py
# (.bak มีเนื้อ alert ของผู้ใช้เต็ม ๆ — หลุดไม่ได้เท่ากับตัวไฟล์หลัก)
alerts/data/price_alerts.json
# scheduler: เดือนที่ส่งแผน DCA แล้ว (รันนอก Docker)
.scheduler_state.json
.scheduler_state.json.tmp
alerts/data/price_alerts.json.bak
alerts/data/price_alerts.json.lock
alerts/data/price_alerts.json.tmp.*

# simulation: ข้อมูลที่ดึงสด + ผลล่าสุด สร้างใหม่ได้เสมอ — ไม่ต้องเข้า git (เหลือ .gitkeep ให้ fresh clone มีโฟลเดอร์ ไม่งั้น bind mount สร้างเป็น root)
simulation/data/*
!simulation/data/.gitkeep
