# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ห้าม commit .env และห้ามใส่ค่าจริงลงในไฟล์ตัวอย่างนี้ (เคยมี webhook จริงหลุดมาแล้ว — AUDIT.md H1)

# --- AI ---
# Claude Sonnet 5 — ผู้ให้บริการเดียวของระบบ (AI Advisor / บทวิเคราะห์ / slip OCR)
# ไม่มี fallback แล้ว: ไม่ตั้งคีย์นี้ = ปุ่ม AI แจ้ง error ชัดเจน ส่วนตัวเลข/สัญญาณยังทำงานปกติ
# **มีค่าใช้จ่ายตามจริง** (~0.10-0.30 บาทต่อการวิเคราะห์ 1 ครั้ง)
ANTHROPIC_API_KEY=

# คุมค่าใช้จ่าย: AI ทำงานเฉพาะตอน "กดปุ่มในหน้าเว็บ" เท่านั้น (ค่าเริ่มต้น)
# งานอัตโนมัติทั้งหมด (cron, GitHub Actions, screener) จะส่งแค่ตัวเลขจากโมเดล ซึ่งฟรี
# ตั้งเป็น 1 ถ้าต้องการให้งานอัตโนมัติเรียก AI ด้วย (จะมีค่าใช้จ่ายทุกรอบที่รัน)
VAULTIS_LLM_AUTO=

# --- แจ้งเตือน ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- แหล่งข้อมูล ---
FRED_API_KEY=
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=VaultisBot/1.0

# --- ระบบ ---
# PostgreSQL สำหรับ sentiment + screener history (เว้นว่าง = ข้ามฟีเจอร์นี้ ระบบที่เหลือทำงานปกติ)
#
# `docker compose up -d` ยก Postgres ขึ้นให้ในเครื่องเอง แล้วสร้างตารางด้วย
#   python scripts/init_db.py
# ค่าด้านล่างคือ URL สำหรับรัน dashboard/backend **นอก** Docker (พอร์ตเปิดที่ 127.0.0.1)
# ส่วน container ใช้ชื่อ service เอง (compose ตั้ง DATABASE_URL ทับให้แล้ว ไม่ต้องแก้ที่นี่)
DATABASE_URL=postgresql+psycopg2://vaultis:vaultis@localhost:5432/vaultis
# ตั้งรหัสผ่านเองได้ — ต้องตรงกับที่ใส่ใน DATABASE_URL ข้างบน แล้ว `docker compose up -d`
# (เปลี่ยนหลังสร้าง volume แล้วต้อง `docker compose down -v` ก่อน ข้อมูลเดิมจะหาย)
POSTGRES_USER=vaultis
POSTGRES_PASSWORD=vaultis
POSTGRES_DB=vaultis
# URL ของ backend ที่ dashboard/jobs เรียกใช้ — ใช้จาก **ในเครื่อง/ในคอนเทนเนอร์**
BACKEND_URL=http://localhost:8000

# URL ของ WebSocket ราคาเรียลไทม์ที่ **เบราว์เซอร์ของผู้ใช้** เป็นคนต่อ
# คนละมุมมองเครือข่ายกับ BACKEND_URL — ห้ามคัดลอกค่าเดียวกันมาใส่:
# docker compose ตั้ง BACKEND_URL=http://backend:8000 (ชื่อภายในเครือข่าย Docker)
# ซึ่งเบราว์เซอร์บนโฮสต์ resolve ไม่ได้ ⇒ แถบราคาขึ้น "⚠️ ดึงไม่ได้ (WS error)" ทุกตัว
# เว้นว่าง = เดาจาก BACKEND_URL ให้ (ใน Docker เดาเป็น ws://127.0.0.1:8000/ws/prices
# พร้อมข้อความบอกบนหน้าจอว่าเดามา) · ตั้งเองเมื่อเปิดให้เครื่องอื่นเข้าหรืออยู่หลัง
# reverse proxy เช่น wss://vaultis.example.com/ws/prices   (AUDIT_ROUND2_2026-08-07)
VAULTIS_WS_URL=

# ระดับ log ของทั้งสองทางเข้า (uvicorn backend.main:app และ python main.py)
# เว้นว่าง = INFO ซึ่งเป็นระดับที่บรรทัดสรุป screener ("... ตรวจไม่ได้ N ตัว") และ
# บรรทัดค่าใช้จ่าย LLM ใช้อยู่ — ตั้ง WARNING เพื่อหรี่, DEBUG เพื่อไล่ปัญหา
# (uvicorn --log-level ใช้แทนกันไม่ได้: มันตั้งเฉพาะ logger ชื่อ uvicorn*)
VAULTIS_LOG_LEVEL=

# --- ความปลอดภัยของ backend ---
# ถ้า deploy backend ขึ้นเน็ต **ต้องตั้ง** — endpoint ที่เปลี่ยนข้อมูล/เรียก LLM
# จะต้องส่ง header X-API-Key ให้ตรงกับค่านี้ (ไม่ตั้ง = รับเฉพาะคำขอจาก localhost)
#
# **รันด้วย Docker ต้องตั้งเสมอ**: ใน container คำขอจาก host มาถึงเป็น IP ของ bridge
# (172.x) ไม่ใช่ 127.0.0.1 ข้อยกเว้น localhost จึงไม่มีผล → route เหล่านั้นตอบ 503
# จนกว่าจะตั้งคีย์  (หน้า dashboard ไม่กระทบ — เรียกโมดูล analysis ตรง ๆ ไม่ผ่าน API)
VAULTIS_API_KEY=
# origin ที่อนุญาตให้เบราว์เซอร์เรียก API (คั่นด้วย ,) — ว่าง = localhost:8501 เท่านั้น
VAULTIS_ALLOWED_ORIGINS=
